<Project>
    <!-- Fix https://github.com/dotnet/sourcelink/issues/572 -->
    <PropertyGroup>
        <TargetFrameworkMonikerAssemblyAttributesPath>$([System.IO.Path]::Combine('$(IntermediateOutputPath)','$(TargetFrameworkMoniker).AssemblyAttributes$(DefaultLanguageSourceExtension)'))</TargetFrameworkMonikerAssemblyAttributesPath>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedFiles Include="$(GeneratedAssemblyInfoFile)" />
    </ItemGroup>
    <!-- Fix end -->
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Workaround for BenchmarkDotNet 0.16+ isolated build/execution directories (.bdn/1/b) -->
    <Target Name="SyncBenchmarkOutputForBdn" AfterTargets="Build" Condition="$(MSBuildProjectName.EndsWith('-gen'))">
        <PropertyGroup>
            <!-- Resolve the shared repository output directory (with or without TargetFramework subfolder) -->
            <OriginalOutDir Condition="Exists('$(MSBuildThisFileDirectory)bin\$(TargetFramework)\')">$(MSBuildThisFileDirectory)bin\$(TargetFramework)\</OriginalOutDir>
            <OriginalOutDir Condition="'$(OriginalOutDir)' == ''">$(MSBuildThisFileDirectory)bin\</OriginalOutDir>
        </PropertyGroup>
        <ItemGroup>
            <!-- Include all runtime assets (JARs, native libraries, configs) while excluding the host entry-point files -->
            <AllOriginalFiles Include="$(OriginalOutDir)**\*"
                              Exclude="$(OriginalOutDir)JNetBenchmarksTest.exe;$(OriginalOutDir)JNetBenchmarksTest.dll;$(OriginalOutDir)JNetBenchmarksTest.pdb;$(OriginalOutDir)JNetBenchmarksTest.deps.json;$(OriginalOutDir)JNetBenchmarksTest.runtimeconfig.json" />
        </ItemGroup>
        <Copy SourceFiles="@(AllOriginalFiles)"
              DestinationFiles="@(AllOriginalFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
